try {
  const resultado = await resend.emails.send({
    from: 'onboarding@resend.dev',
    to: emailNormalized,
    subject: 'Activa tu cuenta de conductor',
    html: `<p>Tu enlace: <a href="${enlace}">Activar cuenta</a></p>`
  });
  console.log('Email enviado:', resultado); // 👈
} catch (emailError) {
  console.error('Error Resend:', emailError); // 👈
}